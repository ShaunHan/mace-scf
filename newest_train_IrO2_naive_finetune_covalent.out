    (state_vector): Linear(in_features=2, out_features=16, bias=False)
    (neighbor_scalar): Linear(in_features=2, out_features=64, bias=False)
    (neighbor_vector): Linear(in_features=2, out_features=16, bias=False)
    (neighbor_divergence): Linear(in_features=2, out_features=64, bias=False)
    (neighbor_gradient): Linear(in_features=2, out_features=16, bias=False)
