    (chemical_vector): Linear(in_features=512, out_features=16, bias=False)
    (shared): Sequential(
      (0): Linear(in_features=96, out_features=64, bias=True)
      (1): SiLU()
      (2): Linear(in_features=64, out_features=64, bias=True)
      (3): SiLU()
    )
    (vector_out): Linear(in_features=64, out_features=96, bias=True)
    (scalar_out): Linear(in_features=64, out_features=4, bias=True)
    (dipole_hardness): Linear(in_features=64, out_features=1, bias=True)
    (state_scalar): Linear(in_features=3, out_features=64, bias=False)
    (state_vector): Linear(in_features=3, out_features=16, bias=False)
    (neighbor_scalar): Linear(in_features=3, out_features=64, bias=False)
    (neighbor_vector): Linear(in_features=3, out_features=16, bias=False)
    (neighbor_divergence): Linear(in_features=3, out_features=64, bias=False)
    (neighbor_gradient): Linear(in_features=3, out_features=16, bias=False)
    (common_level): Linear(in_features=64, out_features=1, bias=False)
    (local_source_scalar): Linear(in_features=64, out_features=2, bias=False)
    (local_source_vector): Linear(in_features=16, out_features=2, bias=False)
  )
  (local_electron_energy): Identity()
  (external_field_contribution): DisplacedGTOExternalFieldBlock()
  (external_field_contribution_internal): GTOInternalFieldtoFeaturesBlock()
  (coulomb_energy): GTOElectrostaticEnergy(
    (density_basis): GTOBasis(
